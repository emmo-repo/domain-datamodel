<https://w3id.org/emmo/domain/datamodel/collection> rdf:type owl:Ontology ;
                                         owl:versionIRI <https://w3id.org/emmo/domain/datamodel/0.0.2/collection> ;
                                         owl:imports <https://w3id.org/emmo/domain/datamodel/0.0.2/transaction> ;
                                         dcterms:abstract "An extension of the metamodel adding collections."@en ;
