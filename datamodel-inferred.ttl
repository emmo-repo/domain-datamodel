            owl:onProperty [ owl:inverseOf ns1:EMMO_9e3ad976_b179_4315_b51e_7e874df583dc ] ;
            owl:someValuesFrom ns1:EMMO_e999f9e0_7d63_4564_9028_07246580a267 ],
        ns1:EMMO_35d2e130_6e01_41ed_94f7_00b333d46cf9 ;
    skos:example "A random generated id for a product."@en ;
    skos:prefLabel "Uncoded"@en ;
    ns1:elucidation "A conventional that provides no possibility to infer the characteristics of the object to which it refers."@en .

ns1:EMMO_6fa1feac_c388_44cc_a721_283499d5addc a owl:Class ;
    rdfs:label "QuantumData"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/reference/data#> ;
    rdfs:subClassOf ns1:EMMO_1e1cfc11_aa1a_44d4_a8d0_31e26deb2d19 ;
    skos:prefLabel "QuantumData"@en ;
    ns1:elucidation "Data that are expressed through quantum mechanical principles, and that can have several values ​​/ be in several states in the same place at the same time (quantum superposition), each of them with a certain probability."@en .

