ns1:OWL2DLRestrictedAxiom a owl:AnnotationProperty ;
    rdfs:label "OWL2DLRestrictedAxiom"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/annotations#> ;
    rdfs:subPropertyOf rdfs:comment ;
    skos:prefLabel "OWL2DLRestrictedAxiom"@en ;
    ns1:elucidation "Axiom not included in the theory because of OWL 2 DL global restrictions for decidability."@en .

ns1:OWLRL2DLAxioms a owl:AnnotationProperty ;
    rdfs:label "OWLRL2DLAxioms"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/annotations#> ;
    rdfs:subPropertyOf rdfs:comment ;
    skos:prefLabel "OWLRL2DLAxioms"@en ;
    ns1:elucidation "Axioms to add to the OWL 2 RL version of the ontology to reach DL expressivity."@en .

ns1:etymology a owl:AnnotationProperty ;
    rdfs:label "etymology"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/annotations#> ;
    rdfs:subPropertyOf rdfs:comment ;
    skos:prefLabel "etymology"@en ;
    ns1:elucidation "The etymology annotation explains the origin of a word and the historical development of its meaning."@en ;
    ns1:note "Definitions are usually taken from Wiktionary."@en,
        "The etymology annotation is usually applied to rdfs:label entities, to better understand the connection between a label and the concept it concisely represents."@en .

:DataInstance a owl:Class ;
    rdfs:label "DataInstance"@en ;
    rdfs:comment """An instance representing actual data.

It is hence disjoint from Metadata."""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/metamodel#> ;
    rdfs:subClassOf :Instance ;
    skos:prefLabel "DataInstance"@en ;
    :instanceOf :Entity .

:EMMO_23057c59_2137_40ab_84a4_748933a689df a owl:ObjectProperty ;
    rdfs:label "hasShape"@en ;
    rdfs:comment "The shape of a property. May be an empty shape."@en ;
    rdfs:domain :Property ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:range :Shape ;
    rdfs:subPropertyOf :composition ;
    skos:prefLabel "hasShape"@en .

:EntitySchema a owl:Class ;
    rdfs:label "EntitySchema"@en ;
    rdfs:comment "A meta-metadata that describes an entity."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/metamodel#> ;
    rdfs:subClassOf :Entity,
        :Metadata ;
    skos:prefLabel "EntitySchema"@en ;
    :instanceOf :BasicMetadataSchema .

:hasDimensionSize a owl:DatatypeProperty ;
    rdfs:label "hasDimensionSize"@en ;
    rdfs:comment "The size of a dimension value."@en ;
    rdfs:domain :DimensionValue ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/metamodel#> ;
    rdfs:range xsd:integer ;
    skos:prefLabel "hasDimensionSize"@en .

:hasDimensionValue a owl:ObjectProperty ;
    rdfs:label "hasDimensionValue"@en ;
    rdfs:domain :Instance ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/metamodel#> ;
    rdfs:range :DimensionValue ;
    rdfs:subPropertyOf :composition ;
    skos:prefLabel "hasDimensionValue"@en .

:hasFirst a owl:ObjectProperty ;
    rdfs:label "hasFirst"@en ;
    rdfs:comment "Relates a whole with an ordered set of parts (elements) to its first element."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:subPropertyOf :composition ;
    skos:prefLabel "hasFirst"@en .

:hasFirstDimensionExpression a owl:ObjectProperty ;
    rdfs:label "hasFirstDimensionExpression"@en ;
    rdfs:comment "The first dimension expression of a shape."@en ;
    rdfs:domain :Shape ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:range :DimensionExpression ;
    rdfs:subPropertyOf :hasFirst ;
    skos:prefLabel "hasFirstDimensionExpression"@en .

:hasMeta a owl:DatatypeProperty ;
    rdfs:label "hasMeta"@en ;
    rdfs:comment "Relates an instance to the URI that uniquely identifies the metadata that describes the instance."@en ;
    rdfs:domain :Instance ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/metamodel#> ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf :dataComposition ;
    skos:prefLabel "hasMeta"@en .

:hasNext a owl:ObjectProperty ;
    rdfs:label "hasNext"@en ;
    rdfs:comment "Relates an element in an ordered list to its next element."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:subPropertyOf :aggregation ;
    skos:prefLabel "hasNext"@en .

:hasNextDimensionExpression a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "hasNextDimensionExpression"@en ;
    rdfs:comment "Relates a dimension expression to the next dimension expression."@en ;
    rdfs:domain :DimensionExpression ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:range :DimensionExpression ;
    rdfs:subPropertyOf :hasNext ;
    skos:prefLabel "hasNextDimensionExpression"@en .

:hasParent a owl:ObjectProperty ;
    rdfs:label "hasParent"@en ;
    rdfs:comment "Relates an transaction instance to its parent instance."@en ;
    rdfs:domain :Transaction ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/transaction#> ;
    rdfs:range :Instance ;
    rdfs:subPropertyOf :aggregation ;
    skos:prefLabel "hasParent"@en .

:hasParentHash a owl:DatatypeProperty ;
    rdfs:label "hasParentHash"@en ;
    rdfs:comment "Hash of the parent instance of a transaction."@en ;
    rdfs:domain :Transaction ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/transaction#> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf :dataRelation ;
    skos:prefLabel "hasParentHash"@en .

:hasPropertyValue a owl:ObjectProperty ;
    rdfs:label "hasPropertyValue"@en ;
    rdfs:domain :Instance ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/metamodel#> ;
    rdfs:range :PropertyValue ;
    rdfs:subPropertyOf :composition ;
    skos:prefLabel "hasPropertyValue"@en .

:hasUUID a owl:DatatypeProperty ;
    rdfs:label "hasUUID"@en ;
    rdfs:comment "Refers to a unique UUID identifying an instance."@en ;
    rdfs:domain :Instance ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/metamodel#> ;
    rdfs:range xsd:string ;
    skos:prefLabel "hasUUID"@en .

:hasUnit a owl:DatatypeProperty ;
    rdfs:label "hasUnit"@en ;
    rdfs:comment "May be omitted for dimensionless quantities."@en,
        "May change in the future."@en,
        "Refer to a unit. Normally just a string with a conventional unit, like \"m/s\". Ideally this should be an object property referring to a unit in an ontology."@en ;
    rdfs:domain :Property ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataComposition ;
    skos:prefLabel "hasUnit"@en .

:hasValue a owl:DatatypeProperty ;
    rdfs:label "hasValue"@en ;
    rdfs:comment """The actual literal value of a dimension expression or a property of a data object.

The syntax of the actual value is implementation dependent."""@en ;
    rdfs:domain :DataModel ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:range rdf:PlainLiteral ;
    rdfs:subPropertyOf :dataComposition ;
    skos:prefLabel "hasValue"@en .

ns1:EMMO_06658d8d_dcde_4fc9_aae1_17f71c0bcdec a owl:Class ;
