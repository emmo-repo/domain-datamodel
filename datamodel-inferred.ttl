    skos:prefLabel "Base64Binary"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: hasDataValue some xsd:base64Binary"^^xsd:string ;
    ns1:elucidation "Base-64 encoding of binary data."@en .

