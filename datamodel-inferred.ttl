            owl:onProperty ns1:EMMO_b2282816_b7a3_44c6_b2cb_3feff1ceb7fe ;
            owl:someValuesFrom ns1:EMMO_06658d8d_dcde_4fc9_aae1_17f71c0bcdec ],
        ns1:EMMO_28fbea28_2204_4613_87ff_6d877b855fcd,
        ns1:EMMO_e12dcfa4_c9f1_4546_9a12_8457c052e6ba ;
    skos:altLabel "2DArray"@en ;
    skos:prefLabel "Matrix"@en ;
    ns1:elucidation "2-dimensional array who's spatial direct parts are vectors."@en .

ns1:EMMO_1cfd072d_2157_43e2_b9f6_ff1e7a708774 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "isIncomingOverlappedBy"@en ;
    rdfs:domain ns1:EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de ;
