            owl:someValuesFrom ns1:EMMO_90ae56e4_d197_49b6_be1a_0049e4756606 ],
        ns1:EMMO_846b637b_7b12_47a1_9430_0274b2f588ac ;
    skos:example "Accelerating is a behaviour of a car."@en ;
