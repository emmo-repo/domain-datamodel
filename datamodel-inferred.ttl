    rdfs:range ns1:EMMO_0cd58641_824c_4851_907f_f4c3be76630c ;
    rdfs:subPropertyOf ns1:EMMO_60577dea_9019_4537_ac41_80b0fb563d41 ;
    owl:inverseOf ns1:EMMO_c4017688_965b_4201_acb2_2f1caf2be760 ;
    skos:prefLabel "hasIndex"@en ;
    ns1:elucidation "A semiotic relation that connects a deduced semiotic object to an index in a deduction process."@en .

ns1:EMMO_2a888cdf_ec4a_4ec5_af1c_0343372fc978 a owl:Class ;
    rdfs:label "Objective"@en ;
    rdfs:comment """The word objective does not mean that each observation will provide the same results. It means that the observation followed a well defined procedure.

This class refers to what is commonly known as physical property, i.e. a measurable property of physical system, whether is quantifiable or not."""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf ns1:EMMO_4292fdcd_bbba_4d99_95c6_daa533d952ef ;
    skos:prefLabel "Objective"@en ;
    ns1:elucidation "A coded conventional that is determined by each interpeter following a well defined determination procedure through a specific perception channel."@en .

ns1:EMMO_2b1303e8_d4c3_453b_9918_76f1d009543f a owl:Class ;
    rdfs:label "Multiplication"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "*"^^xsd:string ;
            owl:onProperty ns1:EMMO_436c8a78_f95d_42a0_9854_07ad3736f061 ],
        ns1:EMMO_5f334606_f67d_4f0e_acb9_eeb21cb10c66,
        ns1:EMMO_707f0cd1_941c_4b57_9f20_d0ba30cd6ff3 ;
    skos:prefLabel "Multiplication"@en .

ns1:EMMO_2b44fb2a_ada8_46af_a961_6e534a61416d a owl:Class ;
    rdfs:label "Verifying"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf ns1:EMMO_1783139f_575f_4e41_a409_1e70aceced27 ;
    skos:prefLabel "Verifying"@en ;
    ns1:elucidation "A semiosis where an interpretant, already present in the internal representational space of the interpreter, is resolved by the interpreter by identifying the referent, i.e. the entity for which the sign stands for according to the interpreter understanding."@en .

ns1:EMMO_2d572205_274c_414a_9564_01c3e14e3c8f a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "isInfluencedBy"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:range ns1:EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce ;
    rdfs:subPropertyOf ns1:EMMO_86726b7c_b208_4690_893e_0cc798fac974 ;
    owl:inverseOf ns1:EMMO_3c51ea74_43a4_42d5_953b_fcb43f359c73 ;
    skos:prefLabel "isInfluencedBy"@en ;
    ns1:elucidation "The relation between an object O that proper overlaps a process P, where the non-overlapping part of P causes O."@en ;
    ns1:illustration "https://raw.githubusercontent.com/emmo-repo/EMMO/dev/doc/figs/isInfluencedBy.png"^^xsd:string .

ns1:EMMO_2dddfc30_d4e1_4e3e_a0ca_755c4d9d2cf4 a owl:Class ;
    rdfs:label "Heap"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/structural#> ;
    rdfs:subClassOf ns1:EMMO_bbca6dfa_7463_4e8d_8280_35862ff50ce0 ;
    skos:prefLabel "Heap"@en ;
    ns1:elucidation "The superclass for all classes of entities that have at least two non overlapping proper parts of the same type of the whole."@en ;
    ns1:illustration "https://raw.githubusercontent.com/emmo-repo/EMMO/1.0.2/doc/figs/Heap.png"^^xsd:anyURI ;
    ns1:note "A heap class H (subclass of Heap) is defined by choosing a reference type φ, with H subclass of φ, so that each H entity has non overlapping φ parts."@en .

ns1:EMMO_2eb10b5b_900b_44d7_af85_4de9a3729474 a owl:ObjectProperty ;
    rdfs:label "hasInterval"@en ;
