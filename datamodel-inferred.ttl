    skos:prefLabel "SymbolicByStructure"@en ;
    ns1:elucidation "Symbolic caterorised by its internal structure."@en .

ns1:EMMO_11501e0a_4442_4bd0_8483_7ea6dc8ba444 a owl:ObjectProperty ;
    rdfs:label "directlyCausedBy"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:seeAlso ns1:EMMO_555d0261_da5e_4301_b7f9_46f604a32e91 ;
    rdfs:subPropertyOf ns1:EMMO_6735d3ff_67f8_43b5_b5b0_240fbfab4517 ;
    owl:inverseOf ns1:EMMO_555d0261_da5e_4301_b7f9_46f604a32e91 ;
    skos:altLabel "hasDirectCause"^^xsd:string ;
    skos:prefLabel "directlyCausedBy"@en .

ns1:EMMO_1494c1a9_00e1_40c2_a9cc_9bbf302a1cac a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "isInputOf"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:subPropertyOf ns1:EMMO_64be8885_2c8a_4e84_a4fc_9d2de61b4d0d ;
    owl:inverseOf ns1:EMMO_36e69413_8c59_4799_946c_10b05d266e22 ;
    skos:prefLabel "isInputOf"@en .

ns1:EMMO_15db234d_ecaf_4715_9838_4b4ec424fb13 a owl:Class ;
    rdfs:label "Reductionistic"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/reductionistic#> ;
    rdfs:subClassOf ns1:EMMO_49267eba_5548_4163_8f36_518d65b583f9 ;
    skos:prefLabel "Reductionistic"@en ;
    ns1:elucidation "A class devoted to categorize causal objects by specifying their granularity levels."@en ;
    ns1:note """A granularity level is specified by a tiling decomposition of the whole y. A tiling is identified as a set of items {x1, x2, ... xn} called tiles that:
    - are proper parts of y
    - covers the entire whole (y = x1 +x2 + ... + xn)
    - do not overlap
    - are part of one, and one only, whole (inverse functional)"""@en,
        "Direct parthood is the antitransitive parthood relation used to build the class hierarchy (and the granularity hierarchy) for this perspective."@en .

ns1:EMMO_18d180e4_5e3e_42f7_820c_e08951223486 a owl:Class ;
    rdfs:label "RealData"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/reference/symbolic#> ;
    rdfs:subClassOf ns1:EMMO_8b305b63_6fa3_44dd_9679_17eb8403a07a ;
    skos:prefLabel "RealData"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: hasDataValue some owl:real"^^xsd:string ;
    ns1:elucidation "A data representing a real number."@en .

ns1:EMMO_1a40459e_10d8_49b3_bb8c_c3595fb1d0bb a owl:Class ;
    rdfs:label "DataByStructure"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/reference/data#> ;
    rdfs:subClassOf ns1:EMMO_3e7add3d_e6ed_489a_a796_8e31fef9b490 ;
    skos:prefLabel "DataByStructure"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: Dataset or Datum"^^xsd:string ;
    ns1:elucidation "Categorisation of data by its structure."@en .

ns1:EMMO_1c0b22a2_be82_4fa8_9e2b_a569a625d442 a owl:Class ;
    rdfs:label "Estimation"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:EMMO_cb804456_9459_4be5_ac63_a291a872fbd0 ;
            owl:someValuesFrom ns1:EMMO_4a1c73f1_b6f5_4d10_a3a6_5de90bac7cd0 ],
        ns1:EMMO_10a5fd39_06aa_4648_9e70_f962a9cb2069 ;
    skos:prefLabel "Estimation"@en ;
    ns1:elucidation "A determination of an object without any actual interaction."@en .

ns1:EMMO_1cba0b27_15d0_4326_933f_379d0b3565b6 a owl:Class ;
    rdfs:label "Matrix"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
