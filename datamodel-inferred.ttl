    rdfs:seeAlso ns1:EMMO_d67ee67e_4fac_4676_82c9_aec361dba698 ;
    rdfs:subPropertyOf ns1:EMMO_ad0e72fc_dcaa_490d_8371_b4d814dcda2c ;
    owl:inverseOf ns1:EMMO_32eb7161_60ed_4431_8326_81a92aec088c ;
    owl:propertyDisjointWith ns1:EMMO_d67ee67e_4fac_4676_82c9_aec361dba698 ;
    skos:prefLabel "isNotCauseOf"@en ;
    ns1:definition "x isNotCauseOf y iff not(x isCauseOf y)"@en .

ns1:EMMO_0d829933_29e3_4e61_b3d3_88e6b9d0d0ce a owl:ObjectProperty ;
    rdfs:label "hasDeclared"@en ;
    rdfs:domain ns1:EMMO_2d72e38c_d587_437f_98f6_f2718fb130eb ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subPropertyOf ns1:EMMO_f2fc1ce9_cc3b_4eb5_a112_3c85d1b1374a ;
    skos:prefLabel "hasDeclared"@en ;
    ns1:elucidation "A semiotic relation connecting a declaring interpreter to the \"declared\" semiotic object in a declaration process."@en .

ns1:EMMO_10bbe9e9_46b6_4b5d_8b51_ed759fc21f21 a owl:Class ;
    rdfs:label "DateTimeStampData"@en ;
