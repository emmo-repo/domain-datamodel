ns1:EMMO_64e4d7b0_f07b_4328_9282_7bf9fb0c3d09 a owl:ObjectProperty ;
    rdfs:label "hasPropertyPart"@en ;
    rdfs:domain ns1:EMMO_35d4c439_fcb6_4399_a855_a89a207b41e9 ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
