ns1:EMMO_f68858dd_64f4_4877_b7fb_70d04fbe5bab a owl:Class ;
    rdfs:label "ConstitutiveProcess"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:EMMO_e3850f08_8e79_454b_9d83_c517cab42857 ] ;
            owl:someValuesFrom ns1:EMMO_90ae56e4_d197_49b6_be1a_0049e4756606 ],
        ns1:EMMO_846b637b_7b12_47a1_9430_0274b2f588ac ;
    skos:example "Blood circulation in a human body."@en ;
    skos:prefLabel "ConstitutiveProcess"@en ;
    ns1:elucidation "A process which is a spatial part of an object."@en ;
    ns1:note "A constitutive process is a process that is holistically relevant for the definition of the whole."@en .

ns1:EMMO_f702bad4_fc77_41f0_a26d_79f6444fd4f3 a owl:ObjectProperty ;
