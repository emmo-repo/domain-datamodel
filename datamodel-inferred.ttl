ns1:EMMO_4ce76d7f_03f8_45b6_9003_90052a79bfaa a owl:Class ;
    rdfs:label "Numerical"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
