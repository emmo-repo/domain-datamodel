    rdfs:subPropertyOf ns1:EMMO_55354438_7000_4284_b1b9_59d60c2261b9 ;
    ns1:elucidation "The relation connecting a description with its property parts. Description and parts are signs for the same entity"@en ;
    ns1:note "This relation is used to specify the detailed information that make up the overall description for an entity. A description can be used to summarize in one single entiity several properties relaterd to the same referent."@en .

ns1:EMMO_663859e5_add3_4c9e_96fb_c99399de278d a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "hasJunctionTile"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/reductionistic#> ;
