    ns1:elucidation "A symbolic data representing a 64-bit floating point numbers incl. ±Inf, ±0, NaN."@en .

ns1:EMMO_54dc83cb_06e1_4739_9e45_bc09cead7f48 a owl:Class ;
    rdfs:label "BooleanData"@en ;
