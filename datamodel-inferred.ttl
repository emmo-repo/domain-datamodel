    owl:inverseOf ns1:EMMO_55354438_7000_4284_b1b9_59d60c2261b9 ;
    skos:prefLabel "isPortionPartOf"@en .

ns1:EMMO_08cb807c_e626_447b_863f_e2835540e918 a owl:NamedIndividual,
        ns1:EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac ;
    rdfs:label "universe"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    skos:prefLabel "universe"@en ;
    ns1:conceptualisation "The universe is considered as a causally self-connected object, encompassing all other objects. For this reason is unique."@en ;
    ns1:definition "u ≡ σx⟨P(x, x)⟩"^^xsd:string .

ns1:EMMO_1aed91a3_d00c_48af_8f43_a0c958b2512a a owl:Class ;
    rdfs:label "AlgebraicExpression"@en ;
    rdfs:comment "An expression that has parts only integer constants, variables, and the algebraic operations (addition, subtraction, multiplication, division and exponentiation by an exponent that is a rational number)"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf ns1:EMMO_f9bc8b52_85e9_4b53_b969_dd7724d5b8e4,
        :DimensionExpression ;
    skos:example "2x+3"@en ;
    skos:prefLabel "AlgebraicExpression"@en .

ns1:EMMO_1b52ee70_121e_4d8d_8419_3f97cd0bd89c a owl:Class ;
    rdfs:label "Determiner"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:EMMO_cb804456_9459_4be5_ac63_a291a872fbd0 ] ;
            owl:someValuesFrom ns1:EMMO_10a5fd39_06aa_4648_9e70_f962a9cb2069 ],
        ns1:EMMO_2d72e38c_d587_437f_98f6_f2718fb130eb ;
    skos:prefLabel "Determiner"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: Estimator or Observer"^^xsd:string ;
    ns1:elucidation "An 'interpreter' that perceives another 'entity' (the 'object') through a specific perception mechanism and produces a 'property' (the 'sign') that stands for the result of that particular perception."@en .

ns1:EMMO_1e877c70_3b01_45a8_a8f6_8ce4f6a24660 a owl:Class ;
    rdfs:label "Contrast"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:seeAlso "Luciano Floridi, \"Information - A very Short Introduction\", Oxford University Press., (2010) ISBN 978-0199551378"@en ;
    rdfs:subClassOf ns1:EMMO_49267eba_5548_4163_8f36_518d65b583f9 ;
    skos:altLabel "Dedomena"@en,
        "Pattern"@en ;
    skos:prefLabel "Contrast"@en ;
    ns1:elucidation "A perspective in which entities are represented according to the variation of their properties."@en ;
    ns1:note """A contrast is a causal object whose variations (non-uniformity) can be recognised and eventually interpreted.
A contrast can be of different physical types (e.g., matter, wave, atomic excited states).
How the variations are recognised and eventually decoded depends on the interpreting rules that characterise that type of contrast.
Variations are pure physical variations and do not necessarily possess semantic meaning."""@en,
        "The covering axiom that defines the contrast class discriminates within all the possible causal objects between encoded contrast (data) or non encoded contrast."@en .

ns1:EMMO_28fbea28_2204_4613_87ff_6d877b855fcd a owl:Class ;
    rdfs:label "Array"@en ;
    rdfs:comment """Array subclasses with a specific shape can be constructed with cardinality restrictions.

See Shape4x3Matrix as an example."""@en,
        "Arrays are ordered objects, since they are a subclasses of Arrangement."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf ns1:EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0 ;
    skos:example """A Vector is a 1-dimensional Array with Number as spatial direct parts,
a Matrix is a 2-dimensional Array with Vector as spatial direct parts,
an Array3D is a 3-dimensional Array with Matrix as spatial direct parts,
and so forth..."""@en ;
    skos:prefLabel "Array"@en ;
    ns1:elucidation "Arrays are ordered mathematical objects who's elementary spatial parts are numbers. Their dimensionality is constructed with spatial direct parthood, where 1-dimensional arrays have spatial direct parts Number and n-dimensional array have spatial direct parts (n-1)-dimensional arrays."@en .

ns1:EMMO_2b1fb71c_0eb0_445c_9be7_fb5d30ae79fd a owl:Class ;
    rdfs:label "MixedTiling"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/reductionistic#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:EMMO_74a75cf1_3418_4244_b43c_b5db94635d42 ;
            owl:someValuesFrom ns1:EMMO_d4c95fa1_5bda_4063_a22d_62c81fcea284 ],
        ns1:EMMO_e12dcfa4_c9f1_4546_9a12_8457c052e6ba ;
    skos:prefLabel "MixedTiling"@en ;
    ns1:elucidation "A well formed tessellation with at least a junction tile."@en ;
    ns1:illustration "https://raw.githubusercontent.com/emmo-repo/EMMO/1.0.2/doc/figs/MixedTiling.png"^^xsd:anyURI .

ns1:EMMO_2e46d966_9f14_4673_821e_7c7cf2957926 a owl:Class ;
    rdfs:label "SpatioTemporalTile"^^xsd:string ;
