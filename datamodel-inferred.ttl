:BasicMetadataSchema a owl:Class ;
    rdfs:label "BasicMetadataSchema"@en ;
    rdfs:comment "A basic metadata schema that can describe itself."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/metamodel#> ;
    rdfs:subClassOf :Entity,
        :Metadata ;
    skos:prefLabel "BasicMetadataSchema"@en ;
    :instanceOf :BasicMetadataSchema .

:PropertyValue a owl:Class ;
    rdfs:label "PropertyValue"@en ;
    rdfs:comment "The value of a property of a data object. Since the type system is kept open-ended there are no restriction on the actual value in this ontology. In an actual implementation there will be a restriction."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/metamodel#> ;
    rdfs:subClassOf :DataModel ;
    skos:prefLabel "PropertyValue"@en .

:Transaction a owl:Class ;
    rdfs:label "Transaction"@en ;
    rdfs:comment """A transaction is an instance who has a parent.

The concept of transactions introduces provenance into series of instances. An instance can only have one parent, but the same instance can be the parent of several instances (transactions). 
The parent of a transaction is immutable."""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/transaction#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasParentHash ],
        [ a owl:Restriction ;
            owl:onClass :Instance ;
            owl:onProperty :hasParent ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :Instance ;
    skos:prefLabel "Transaction"@en .

:aggregation a owl:ObjectProperty ;
    rdfs:label "connection"@en ;
    rdfs:comment "A connection between two entities."@en,
        """In UML this is is a subproperty of aggregation that is not a composition.

In EMMO this may be interpreted as 'topological'."""@en ;
    rdfs:domain :DataModel ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:range :DataModel ;
    rdfs:subPropertyOf owl:topObjectProperty,
        ns1:EMMO_8785be5a_2493_4b12_8f39_31907ab11748 ;
    skos:prefLabel "connection"@en .

:hasLabel a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "hasLabel"@en ;
    rdfs:comment "Range is defined as xsd:string, even though xsd:NCName would have been more precise, but that is not supported by the FaCT++ reasoner."@en,
        "Refer to a unique and valid C identifier."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataComposition ;
    skos:prefLabel "hasLabel"@en .

:hasProperty a owl:ObjectProperty ;
    rdfs:label "hasProperty"@en ;
    rdfs:comment "Relates an entity to one of its properties."@en ;
    rdfs:domain :Entity ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:range :Property ;
    rdfs:subPropertyOf :composition ;
    skos:prefLabel "hasProperty"@en .

rdfs:label rdfs:range rdfs:Literal .

ns1:EMMO_07808d05_18d1_4253_96e5_58b8277347de a owl:ObjectProperty ;
