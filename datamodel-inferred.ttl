    skos:prefLabel "notOverlaps"@en ;
    ns1:definition "Dxy ≡ ¬Oxy."^^xsd:string ;
    ns1:elucidation "The relation between individuals representing non-overlapping entities (i.e. that have no parts in common)."@en .

