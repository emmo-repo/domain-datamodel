:Collection a owl:Class ;
    rdfs:label "Collection"@en ;
    rdfs:comment """A collection is a special type of instance that contains a set of (references to) other instances and relations between these instances.

In SOFT and DLite, collections are implemented as instances with a list of relations (rdf subject-predicate-object triples) as their only property. The member instances are referred to with a label that is local to the collection."""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/collection#> ;
    rdfs:subClassOf :Instance ;
    skos:prefLabel "Collection"@en .

:hasHash a owl:DatatypeProperty ;
    rdfs:label "hasHash"@en ;
    rdfs:comment "The hash of an instance."@en ;
    rdfs:domain :Instance ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/transaction#> ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf :dataRelation ;
    skos:prefLabel "hasHash"@en .

:hasRelation a owl:DatatypeProperty ;
    rdfs:label "hasRelation"@en ;
    rdfs:comment """In the case that the type of a property refer to an entity, 'hasRelation' can be used to specify the type of relation between the property and the referred entity.

Typical values are:
  "dm:composition"
  "dm:connection"
  "dm:relation"
or any of their sub-properties."""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:subPropertyOf :dataRelation ;
    skos:prefLabel "hasRelation"@en .

:hasType a owl:DatatypeProperty ;
    rdfs:label "hasType"@en ;
    rdfs:comment "May change in the future."@en,
        "Refer to a comment. Normally just a string with a type name, like \"float\". Ideally this should be an object property referring to a type in an ontology."@en ;
    rdfs:domain :Property ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataComposition ;
    skos:prefLabel "hasType"@en .

:instanceOf a owl:AnnotationProperty ;
    rdfs:label "instanceOf"@en ;
    rdfs:comment "Relates an instance to the class that describes it."@en,
        """The semantic meaning of 'instanceOf' is the same as 'rdf:type'.

But since first order logic, of which OWL descriptive logic is based on, we introduce 'instanceOf' as an annotation property."""@en ;
    rdfs:domain :Instance ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/metamodel#>,
        <rdf:type> ;
    rdfs:range :Metadata ;
    skos:prefLabel "instanceOf"@en .

:relation a owl:ObjectProperty ;
    rdfs:label "relation"@en ;
    rdfs:comment """In UML this is is a subproperty of association that is not an aggregation.

In EMMO this may be interpreted as 'semiotical'."""@en,
        "Note that this object property is not in the datamodel ontology, but may be used as a value of the 'hasRelation' data property of 'Property'."@en ;
    rdfs:domain :DataModel ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:range :DataModel ;
    rdfs:subPropertyOf owl:topObjectProperty,
        ns1:EMMO_2337e25c_3c60_43fc_a8f9_b11a3f974291 ;
    skos:prefLabel "relation"@en .

<https://w3id.org/emmo/domain/datamodel/inferred> a owl:Ontology ;
    ns2:termsabstract "This module connects the SOFT7 data model and the metamodel described in entity.ttl and metamodel.ttl, respectively, to EMMO."@en ;
    ns2:termscreator "Jesper Friis, SINTEF"@en,
        "Thomas Hagelien, SINTEF"@en ;
    ns2:termslicense "https://creativecommons.org/licenses/by/4.0/legalcode"^^xsd:string ;
    ns2:termstitle "Datamodel ontology"@en ;
    owl:versionIRI <https://w3id.org/emmo/domain/0.0.3/datamodel> .

