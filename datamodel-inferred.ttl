    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:subPropertyOf ns1:EMMO_b3c8ba10_6bee_45e7_9416_e9019aa9f023 ;
    skos:prefLabel "incomingOverlaps"@en .

ns1:EMMO_7286b164_df4c_4c14_a4b5_d41ad9c121f3 a owl:Class ;
    rdfs:label "Coded"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:EMMO_9e3ad976_b179_4315_b51e_7e874df583dc ] ;
            owl:someValuesFrom ns1:EMMO_10a5fd39_06aa_4648_9e70_f962a9cb2069 ],
        ns1:EMMO_35d2e130_6e01_41ed_94f7_00b333d46cf9 ;
    skos:example "A biography that makes use of a code that is provided by the meaning of the element of the language used by the author."@en,
        "The name \"red\" that stands for the color of an object."@en ;
    skos:prefLabel "Coded"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: Description or Property"^^xsd:string,
        "EquivalentTo: Observed or Estimated"^^xsd:string,
        "EquivalentTo: Subjective or Objective"^^xsd:string ;
    ns1:elucidation "A conventional that stands for an object according to a code of interpretation to which the interpreter refers."@en ;
    ns1:note """A conventional referring to an object according to a specific code that reflects the results of a specific interaction mechanism and is shared between other interpreters.
A coded is always a partial representation of an object since it reflects the object capability to be part of a specific determination.
A coded is a sort of name or label that we put upon objects that interact with an determiner in the same specific way.

For example, "hot" objects are objects that interact with an observer through a perception mechanism aimed to perceive an heat source. The code is made of terms such as "hot", "warm", "cold", that commonly refer to the perception of heat."""@en,
        """Let's define the class Colour as the subclass of the coded signs that involve photon emission and electromagnetic radiation sensible observers.
An individual C of this class Colour can be defined be declaring the process individual (e.g. daylight illumination) and the observer (e.g. my eyes)
Stating that an entity E hasCoded C, we mean that it can be observed by such setup of process + observer (i.e. observed by my eyes under daylight).
This definition can be specialised for human eye perception, so that the observer can be a generic human, or to camera perception so that the observer can be a device.
This can be used in material characterization, to define exactly the type of measurement done, including the instrument type."""@en .

ns1:EMMO_7fb7fe7e_bdf9_4eeb_adad_e384dd5285c6 a owl:ObjectProperty ;
    rdfs:label "hasInterpretant"@en ;
    rdfs:domain ns1:EMMO_008fd3b2_4013_451f_8827_52bceab11841 ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:range ns1:EMMO_054af807_85cd_4a13_8eba_119dfdaaf38b ;
    rdfs:subPropertyOf ns1:EMMO_f275e4e9_062b_4ca4_a679_4f26ec0a48ae ;
    owl:inverseOf ns1:EMMO_8910edc0_6f56_49d2_9f8f_6b0ff908f2e6 ;
    skos:prefLabel "hasInterpretant"@en ;
    ns1:elucidation "A relation that connects a semiotic object to the interpretant in a semiotic process."@en .

ns1:EMMO_814b6b76_e0ca_4953_a832_d1816fb695f1 a owl:ObjectProperty ;
    rdfs:label "hasDirectPart"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:subPropertyOf ns1:EMMO_9380ab64_0363_4804_b13f_3a8a94119a76 ;
    owl:inverseOf ns1:EMMO_928f6ec2_7564_4c8d_9a10_7a601fa89602 ;
    skos:altLabel "hasImmediatePart"@en ;
    skos:prefLabel "hasDirectPart"@en ;
    ns1:conceptualisation "Direct parthood is the non transitive version of parthood enabling the establishment of hierarchy of granularities, starting with an entity and providing several granularity levels of parthood."@en ;
    ns1:elucidation "The non-transitive version of proper parthood property."@en .

ns1:EMMO_86726b7c_b208_4690_893e_0cc798fac974 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "isJoinedBy"@en ;
    rdfs:domain ns1:EMMO_90ae56e4_d197_49b6_be1a_0049e4756606 ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:subPropertyOf ns1:EMMO_1cfd072d_2157_43e2_b9f6_ff1e7a708774 ;
    skos:prefLabel "isJoinedBy"@en ;
    ns1:elucidation "The relation between an object O that proper overlaps an item I, where the non-overlapping part of I causes O."@en ;
    ns1:illustration "https://raw.githubusercontent.com/emmo-repo/EMMO/dev/doc/figs/isJoinedBy.png"^^xsd:string .

ns1:EMMO_89a0c87c_0804_4013_937a_6fe234d9499c a owl:Class ;
    rdfs:label "SymbolicConstruct"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf ns1:EMMO_1141d225_fe90_4230_82c6_31cab6a4e3fe ;
    skos:prefLabel "SymbolicConstruct"@en ;
    ns1:OWLRL2DLAxioms "SubClassOf: hasProperPart some Symbolic"^^xsd:string ;
    ns1:elucidation "A symbolic entity made of other symbolic entities according to a specific spatial configuration."@en ;
    ns1:note "This class collects individuals that represents arrangements of strings, or other symbolic compositions, without any particular predefined arrangement schema."@en .

ns1:EMMO_8b305b63_6fa3_44dd_9679_17eb8403a07a a owl:Class ;
    rdfs:label "NumericData"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/reference/symbolic#> ;
    rdfs:subClassOf ns1:EMMO_70bbb94e_2ca7_4d73_ba01_6397f134d172 ;
    skos:prefLabel "NumericData"@en ;
    ns1:elucidation "A symbolic data representing a numerical value."@en .

ns1:EMMO_8e52c42b_e879_4473_9fa1_4b23428b392b a owl:ObjectProperty ;
    rdfs:label "hasRole"@en ;
    rdfs:domain ns1:EMMO_1efe8b96_e006_4a33_bc9a_421406cbb9f0 ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/holistic#> ;
    rdfs:range ns1:EMMO_4f226cf3_6d02_4d35_8566_a9e641bc6ff3 ;
    rdfs:subPropertyOf ns1:EMMO_a9a9d824_5ba1_4dac_a407_e42bf63350ca ;
    skos:altLabel "hasHolisticPart"@en ;
    skos:example "An holistic part of water fluid is a water molecule."@en ;
    skos:prefLabel "hasRole"@en ;
    ns1:elucidation "The relation between the whole and a proper part of the whole that scale down to the point which it lose the characteristics of the whole and become something else."@en .

ns1:EMMO_9e029526_79a2_47a8_a151_dd0545db471b a owl:Class ;
    rdfs:label "NumericalVariable"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf ns1:EMMO_1eed0732_e3f1_4b2c_a9c4_b4e75eeb5895 ;
    skos:prefLabel "NumericalVariable"@en ;
    ns1:elucidation "A variable standing for a numerical defined mathematical object like e.g. a number, a vector of numbers, a matrix of numbers."@en .

ns1:EMMO_a1083d0a_c1fb_471f_8e20_a98f881ad527 a owl:Class ;
    rdfs:label "Symbol"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf ns1:EMMO_1141d225_fe90_4230_82c6_31cab6a4e3fe ;
    skos:altLabel "AlphabeticEntity"@en ;
    skos:example "A letter, a number, a punctuation sign, a space, an UTF-8 character."@en,
        "The class of letter \"A\" is the symbol as idea and the letter A that you see on the screen is the mark that can be represented by an individual belonging to \"A\"."@en ;
    skos:prefLabel "Symbol"@en ;
    ns1:elucidation "The class of individuals that stand for an elementary mark of a specific symbolic code (alphabet)."@en ;
    ns1:note """Subclasses of 'Symbol' are alphabets, in formal languages terminology. A 'Symbol' is atomic for that alphabet, i.e. it has no parts that are symbols for the same alphabet.
e.g. a math symbol is not made of other math symbols
A Symbol may be a String in another language.
e.g. "Bq" is the symbol for Becquerel units when dealing with metrology, or a string of "B" and "q" symbols when dealing with characters."""@en,
        """Symbols of a formal language need not be symbols of anything. For instance there are logical constants which do not refer to any idea, but rather serve as a form of punctuation in the language (e.g. parentheses).

Symbols of a formal language must be capable of being specified without any reference to any interpretation of them.
(Wikipedia)"""@en,
        "The class is the idea of the symbol, while the individual of that class stands for a specific mark (or token) of that idea."@en .

ns1:EMMO_aa972cc9_5d9e_47a2_abc5_00243d6b3917 a owl:Class ;
    rdfs:label "IntData"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/reference/symbolic#> ;
    rdfs:seeAlso "https://www.w3.org/TR/xmlschema11-2/#int"^^xsd:anyURI ;
    rdfs:subClassOf ns1:EMMO_51f93d8c_57fa_4314_a68d_8d69c2609c97 ;
    skos:prefLabel "IntData"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: hasDataValue some xsd:int"^^xsd:string ;
    ns1:elucidation "A data representing 32-bit integer number."@en .

ns1:EMMO_c4bace1d_4db0_4cd3_87e9_18122bae2840 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "hasOutput"@en ;
    rdfs:domain ns1:EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:subPropertyOf ns1:EMMO_b1a64980_c524_4d48_af8f_9805570ce453 ;
    skos:prefLabel "hasOutput"@en ;
    ns1:elucidation "The relation between a process P that proper overlaps an item I, where the non-overlapping part of I is caused by P."@en ;
    ns1:illustration "https://raw.githubusercontent.com/emmo-repo/EMMO/1.0.2/figs/hasOutput.png"^^xsd:string .

ns1:EMMO_c5b4c32b_74de_403d_96f2_266bec8bd0e8 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "outgoingOverlaps"@en ;
    rdfs:domain ns1:EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:range ns1:EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de ;
    rdfs:subPropertyOf ns1:EMMO_b3c8ba10_6bee_45e7_9416_e9019aa9f023 ;
    skos:prefLabel "outgoingOverlaps"@en .

ns1:EMMO_d8d2144e_5c8d_455d_a643_5caf4d8d9df8 a owl:Class ;
    rdfs:label "Language"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf ns1:EMMO_057e7d57_aff0_49de_911a_8861d85cef40 ;
    skos:prefLabel "Language"@en ;
    ns1:elucidation "A language object is a discrete data entity respecting specific language syntactic rules (a well-formed formula)."@en .

ns1:EMMO_dc57d998_23db_4d8e_b2cd_f346b195b846 a owl:ObjectProperty ;
    rdfs:label "hasSpatialPart"@en ;
    rdfs:domain ns1:EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:subPropertyOf ns1:EMMO_9a50a0ae_841a_46fe_8b23_3df319b60611 ;
    owl:inverseOf ns1:EMMO_f1503598_03af_4fec_a860_ebc77aa92832 ;
    skos:prefLabel "hasSpatialPart"@en ;
    ns1:elucidation "A proper part of a whole, whose parts always cover the full temporal extension of the whole within a spatial interval."@en ;
    ns1:note "In EMMO FOL this is a defined property. In OWL temporal relations are primitive."@en,
        "The part is connected with the rest item or members with hasContact relations only (no hasNext)."@en .

ns1:EMMO_e56ee3eb_7609_4ae1_8bed_51974f0960a6 a owl:Class ;
    rdfs:label "Equation"@en ;
    rdfs:comment """An equation with variables can always be represented as:

f(v0, v1, ..., vn) = g(v0, v1, ..., vn)

where f is the left hand and g the right hand  side expressions and v0, v1, ..., vn are the variables."""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:EMMO_dc57d998_23db_4d8e_b2cd_f346b195b846 ;
            owl:someValuesFrom ns1:EMMO_f9bc8b52_85e9_4b53_b969_dd7724d5b8e4 ],
        ns1:EMMO_88470739_03d3_4c47_a03e_b30a1288d50c,
        ns1:EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac ;
    skos:example """2+3 = 5
x^2 +3x  = 5x
dv/dt = a
sin(x) = y"""@en ;
    skos:prefLabel "Equation"@en ;
    ns1:elucidation "The class of 'mathematical'-s that stand for a statement of equality between two mathematical expressions."@en .

ns1:EMMO_eb3ffec6_3d69_4633_a3b1_088ad53cb00b a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "leaves"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:subPropertyOf ns1:EMMO_c5b4c32b_74de_403d_96f2_266bec8bd0e8 ;
    skos:prefLabel "leaves"@en .

ns1:EMMO_ec2472ae_cf4a_46a5_8555_1556f5a6c3c5 a owl:ObjectProperty ;
    rdfs:label "EMMORelation"@en ;
    rdfs:domain ns1:EMMO_802d3e92_8770_4f98_a289_ccaaab7fdddf ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:range ns1:EMMO_802d3e92_8770_4f98_a289_ccaaab7fdddf ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    skos:prefLabel "EMMORelation"@en ;
    ns1:elucidation "The superclass for all relations used by the EMMO."@en .

ns1:EMMO_f7f41d20_eabb_4bcb_9a16_0436851fcd5c a owl:Class ;
    rdfs:label "TemporalTiling"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/reductionistic#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:EMMO_504ad89e_dd4a_4fa6_aeb6_15c8ce0cde9b ;
            owl:onProperty ns1:EMMO_7efab93d_c8fe_49c7_ba8e_d21d13b38c85 ],
        ns1:EMMO_e12dcfa4_c9f1_4546_9a12_8457c052e6ba ;
    skos:prefLabel "TemporalTiling"@en ;
    ns1:elucidation "A well formed tessellation with tiles that are all temporal."@en ;
    ns1:illustration "https://w3id.org/emmo/raw/1.0.4/doc/figs/TemporalTile.png"^^xsd:anyURI .

ns1:EMMO_ffe760a2_9d1f_4aef_8bee_1f450f9cb00d a owl:Class ;
    rdfs:label "MathematicalConstruct"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:EMMO_9380ab64_0363_4804_b13f_3a8a94119a76 ;
            owl:someValuesFrom ns1:EMMO_5be83f9c_a4ba_4b9a_be1a_5bfc6e891231 ],
        ns1:EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0,
        ns1:EMMO_89a0c87c_0804_4013_937a_6fe234d9499c ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0 ns1:EMMO_89a0c87c_0804_4013_937a_6fe234d9499c ) ] ;
    skos:prefLabel "MathematicalConstruct"@en ;
    ns1:elucidation "A construct of two or more mathematical symbols."@en .

ns1:conceptualisation a owl:AnnotationProperty ;
    rdfs:label "conceptualisation"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/annotations#> ;
    rdfs:subPropertyOf rdfs:comment ;
    skos:prefLabel "conceptualisation"@en ;
    ns1:elucidation "The conceptualisation annotation is a comment that helps the reader to understand how the world has been conceptualised by the ontology authors."@en ;
    ns1:note "A conceptualisation is the preliminary step behind each theory, preceding each logical formalisation. The readers approaching an ontology entity should first read the conceptualisation annotation to clearly understand \"what we are talking about\" and the accompanying terminology, and then read the elucidation."@en,
        "An conceptualisation can provide references to external knowledge sources (i.e. ISO, Goldbook, RoMM)."@en .

ns1:elucidation a owl:AnnotationProperty ;
    rdfs:label "elucidation"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/annotations#> ;
    rdfs:subPropertyOf rdfs:comment ;
    skos:prefLabel "elucidation"@en ;
    ns1:elucidation "Short enlightening explanation aimed to facilitate the user in drawing the connection (interpretation) between a OWL entity and the real world object(s) for which it stands."@en ;
    ns1:note "An elucidation should address the real world entities using the concepts introduced by the conceptualisation annotation."@en .

:DimensionValue a owl:Class ;
    rdfs:label "DimensionValue"@en ;
    rdfs:comment "Value of a dimension of a an instance."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/metamodel#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty :hasDimensionSize ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:EMMO_f8bd64d5_5d3e_4ad4_a46e_c30714fecb7f,
        :DataModel ;
    skos:prefLabel "DimensionValue"@en .

:Shape a owl:Class ;
    rdfs:label "Shape"@en ;
    rdfs:comment "An element in the list of of dimension in a property."@en,
        "ShapeElement would have been a better name."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :DimensionExpression ;
            owl:onProperty :hasFirstDimensionExpression ],
        ns1:EMMO_36c79456_e29c_400d_8bd3_0eedddb82652,
        :DataModel ;
    skos:prefLabel "Shape"@en .

:dataRelation a owl:DatatypeProperty ;
    rdfs:label "dataRelation"@en ;
    rdfs:comment "A generic relation between a data attribute and a DataModel subclass that is not a connection or composition."@en,
        """In UML this is is a subproperty of association that is not an aggregation.

In EMMO this may be interpreted as 'semiotical'."""@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    skos:prefLabel "dataRelation"@en .

:hasDimension a owl:ObjectProperty ;
    rdfs:label "hasDimension"@en ;
    rdfs:comment "Relates an entity to one of its dimensions."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :DimensionExpression :Entity ) ] ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:range :Dimension ;
    rdfs:subPropertyOf :composition ;
    skos:prefLabel "hasDimension"@en .

ns1:33fd15ab_7662_4cc6_8bf6_988422efc631 a owl:ObjectProperty ;
    rdfs:label "hasMember"@en ;
    rdfs:domain ns1:EMMO_2d2ecd97_067f_4d0e_950c_d746b7700a31 ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:subPropertyOf ns1:EMMO_9380ab64_0363_4804_b13f_3a8a94119a76 ;
    owl:propertyDisjointWith ns1:76413949_896c_4363_a955_de4722c6e149 ;
    skos:altLabel "hasMaximalPart"@en ;
    skos:prefLabel "hasMember"@en ;
    ns1:definition "A proper part which is not connected with the rest of the whole."@en ;
    ns1:elucidation "The relation between individuals representing a collection and one or more of its members."^^xsd:string ;
    ns1:note "A maximal part is a proper part that is not connected with the rest of the whole."@en .

ns1:76413949_896c_4363_a955_de4722c6e149 a owl:ObjectProperty ;
    rdfs:label "hasPiece"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:subPropertyOf ns1:EMMO_9380ab64_0363_4804_b13f_3a8a94119a76 ;
    skos:altLabel "hasNotMaximalPart"@en ;
    skos:prefLabel "hasPiece"@en ;
    ns1:elucidation "The relation between two individuals representing an entity and a non-maximal proper part, meaning the the latter is connected with the rest of the whole."@en ;
    ns1:note "A non-maximal part is a proper part that is connected with the rest of the whole."@en .

ns1:EMMO_0277f24a_ea7f_4917_81b7_fb0406c8fc62 a owl:Class ;
    rdfs:label "Holistic"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/reference/persholistic#> ;
    rdfs:subClassOf ns1:EMMO_49267eba_5548_4163_8f36_518d65b583f9 ;
    skos:altLabel "Wholistic"@en ;
    skos:example "A molecule of a body can have role in the body evolution, without caring if its part of a specific organ and without specifying the time interval in which this role occurred."@en,
        "A product is a role that can be fulfilled by many objects, but always requires a process to which the product participates and from which it is generated."@en ;
    skos:prefLabel "Holistic"@en ;
    ns1:conceptualisation """An holistic perspective considers each part of the whole as equally important, without the need to position the parts within a hierarchy (in time or space). The interest is on the whole, on its parts (how they contribute to the whole, i.e. their roles), and their types, without going further into specifying the spatial hierarchy or the temporal position of each part.
This class allows the picking of parts without necessarily going trough a rigid hierarchy of spatial compositions (e.g. body -> organ -> cell -> molecule) or temporal composition. This is inline with the transitive nature of parthood, as it is usually defined in literature."""@en ;
    ns1:definition "The union of classes whole and part."@en ;
    ns1:elucidation """A perspective characterized by the belief that:
- a whole is more than merely the sum of its parts (wholism)
- the parts of a whole are interconnected in a way that can be explained only by reference to the whole (rolism)."""@en ;
    ns1:note "The holistic perspective is not excluding the reductionistic perspective, on the contrary it can be considered its complement."@en,
        """Whole and roles are defined using parthood relations. However, there also must be a primitive component in the definition, besides parthood, capturing more subtle relations between entities that makes their relation holistic.
For example, a scattering event between an electron and a nucleus requires electron and nucleus types as parts to exist, but this is not enough to make this event an atom, since it requires a persistent bond. So defining something as an atom iff have parts some electons and a nucleus is not enough."""@en .

ns1:EMMO_057e7d57_aff0_49de_911a_8861d85cef40 a owl:Class ;
    rdfs:label "Symbolic"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf ns1:EMMO_be8592a7_68d1_4a06_ad23_82f2b56ef926 ;
    skos:example """fe780
emmo
!5*a
cat
for(i=0;i<N;++i)"""@en ;
    skos:prefLabel "Symbolic"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: SymbolicConstruct or Symbol"^^xsd:string ;
    ns1:elucidation "A discrete data whose elements can be decoded as tokens from one or more alphabets, without necessarily respecting syntactic rules."@en ;
    ns1:note """A symbolic entity is not necessarily graphical (e.g. it doesn't necessarily have the physical shape of a letter), but its elements can be decoded and put in relation with an alphabet.
In other words, a sequence of bit "1000010" in a RAM (a non-graphical entity) is a valid symbol since it can be decoded through ASCII rules as the letter "B". The same holds for an entity standing for the sound of a voice saying: "Hello", since it can be decomposed in discrete parts, each of them being associated to a letter of an alphabet."""@en,
        """A symbolic object possesses a reductionistic oriented structure.
For example, text is made of words, spaces and punctuations. Words are made of characters (i.e. atomic symbols)."""@en .

ns1:EMMO_0cd58641_824c_4851_907f_f4c3be76630c a owl:Class ;
    rdfs:label "Index"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:EMMO_9e3ad976_b179_4315_b51e_7e874df583dc ] ;
            owl:someValuesFrom ns1:EMMO_39a4e2a4_d835_426d_b497_182d06e1caff ],
        ns1:EMMO_4a2bf359_c47b_4aa3_9811_b59c3e1dac1e ;
    skos:example """Smoke stands for a combustion process (a fire).
My facial expression stands for my emotional status."""@en ;
    skos:prefLabel "Index"@en ;
    ns1:elucidation "A 'Sign' that stands for an 'Object' due to causal continguity."@en .

ns1:EMMO_0ed18c6b_8289_44fd_a7d7_c15a8786cdc0 a owl:ObjectProperty ;
    rdfs:label "isInterpretationAccordingTo"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subPropertyOf ns1:EMMO_2337e25c_3c60_43fc_a8f9_b11a3f974291 ;
    owl:inverseOf ns1:EMMO_f2fc1ce9_cc3b_4eb5_a112_3c85d1b1374a ;
    skos:prefLabel "isInterpretationAccordingTo"@en .

ns1:EMMO_10a5fd39_06aa_4648_9e70_f962a9cb2069 a owl:Class ;
    rdfs:label "Determination"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:EMMO_cb804456_9459_4be5_ac63_a291a872fbd0 ;
            owl:someValuesFrom ns1:EMMO_1b52ee70_121e_4d8d_8419_3f97cd0bd89c ],
        [ a owl:Restriction ;
            owl:onProperty ns1:EMMO_9e3ad976_b179_4315_b51e_7e874df583dc ;
            owl:someValuesFrom ns1:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba ],
        ns1:EMMO_47bf3513_4ae6_4858_9c45_76e23230d68d ;
    skos:altLabel "Characterisation"@en ;
    skos:example "Assigning the word \"red\" as sign for an object provides an information to all other interpreters about the outcome of a specific observation procedure according to the determiner."@en ;
    skos:prefLabel "Determination"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: Estimation or Observation"^^xsd:string ;
    ns1:elucidation "A 'Semiosis' that involves an 'Observer' that perceives another 'Physical' (the 'Object') through a specific perception mechanism and produces a 'Property' (the 'Sign') that stands for the result of that particular perception according to a well defined conventional procedure."@en .

ns1:EMMO_1783139f_575f_4e41_a409_1e70aceced27 a owl:Class ;
    rdfs:label "PartialSemiosis"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf ns1:EMMO_3fe33e1c_2b62_4669_af92_8066cf53761d ;
    skos:prefLabel "PartialSemiosis"@en ;
    ns1:elucidation "A semiosis where the triangle of relation is not completely developed."@en .

ns1:EMMO_19608340_178c_4bfd_bd4d_0d3b935c6fec a owl:Class ;
    rdfs:label "Cogniser"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:EMMO_cb804456_9459_4be5_ac63_a291a872fbd0 ] ;
            owl:someValuesFrom ns1:EMMO_7cdc375d_d371_4d78_acd5_d51732f52126 ],
        ns1:EMMO_33dc57d7_68bd_460c_a440_26a78d57ea0d ;
    skos:example "The scientist that connects an equation to a physical phenomenon."^^xsd:string ;
    skos:prefLabel "Cogniser"@en ;
    ns1:elucidation "An interpreter who establish the connection between an icon an an object recognizing their resemblance (e.g. logical, pictorial)"@en .

ns1:EMMO_1efe8b96_e006_4a33_bc9a_421406cbb9f0 a owl:Class ;
    rdfs:label "Whole"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/reference/persholistic#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:EMMO_8e52c42b_e879_4473_9fa1_4b23428b392b ;
            owl:someValuesFrom ns1:EMMO_4f226cf3_6d02_4d35_8566_a9e641bc6ff3 ],
        ns1:EMMO_eb50c9cb_9576_4a61_95ec_f81fb8218187 ;
    skos:prefLabel "Whole"@en ;
    ns1:elucidation "The superclass of entities which are defined by requiring the existence of some parts (at least one) of specifically given types, where the specified types are different with respect to the type of the whole."@en ;
    ns1:note """A whole is always defined using a criterion expressed through the classical transitive parthood relation.
This class is expected to host the definition of world objects as they appear in its wholeness, dependently on some of their parts and independently on the surroundings."""@en,
        "A whole is categorized as fundamental (or maximal) or redundant (non-maximal)."@en .

ns1:EMMO_29e45c39_cc99_43f8_a545_f329f622f551 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "throughOverlaps"@en ;
    rdfs:domain ns1:EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:range ns1:EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de ;
    rdfs:subPropertyOf ns1:EMMO_b3c8ba10_6bee_45e7_9416_e9019aa9f023 ;
    owl:inverseOf ns1:EMMO_d78b940d_4e2a_4a46_816b_da89029adc19 ;
    skos:prefLabel "throughOverlaps"@en ;
    ns1:elucidation "The relation between an item I1 that proper overlaps an Item I2 where I1 has two non-overlapping parts, one that causes I2 and one that is a cause of I2."@en ;
    ns1:illustration "https://raw.githubusercontent.com/emmo-repo/EMMO/dev/doc/figs/throughOverlaps.png"^^xsd:string .

ns1:EMMO_2bb50428_568d_46e8_b8bf_59a4c5656461 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "isOutputOf"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:range ns1:EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce ;
    rdfs:subPropertyOf ns1:EMMO_c5b4c32b_74de_403d_96f2_266bec8bd0e8 ;
    owl:inverseOf ns1:EMMO_c4bace1d_4db0_4cd3_87e9_18122bae2840 ;
    skos:prefLabel "isOutputOf"@en .

ns1:EMMO_451e410e_8e0d_4a4b_9211_d6ef619296dc a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "successorOf"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:subPropertyOf ns1:EMMO_2a28c0dd_89b1_47ac_b81f_fccc56f39617,
        ns1:EMMO_5dc167a2_d50e_47a5_be4f_5139f3bff2ec ;
    skos:altLabel "isAncestorOf"@en ;
    skos:prefLabel "successorOf"@en .

ns1:EMMO_47bf3513_4ae6_4858_9c45_76e23230d68d a owl:Class ;
    rdfs:label "Declaration"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:EMMO_cb804456_9459_4be5_ac63_a291a872fbd0 ;
            owl:someValuesFrom ns1:EMMO_2d72e38c_d587_437f_98f6_f2718fb130eb ],
        [ a owl:Restriction ;
            owl:onProperty ns1:EMMO_9e3ad976_b179_4315_b51e_7e874df583dc ;
            owl:someValuesFrom ns1:EMMO_35d2e130_6e01_41ed_94f7_00b333d46cf9 ],
        ns1:EMMO_4d5621e8_af7f_4aef_abd5_f905a34f62af ;
    skos:altLabel "ConventionalSemiosis"@en ;
    skos:prefLabel "Declaration"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: Determination or Naming"^^xsd:string ;
    ns1:elucidation "A semiotic process that assigns a sign based on conventions."@en .

ns1:EMMO_53ed8611_2cd7_4286_9ef0_36572117b963 a owl:Class ;
    rdfs:label "Fusion"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf ns1:EMMO_802d3e92_8770_4f98_a289_ccaaab7fdddf ;
    skos:example "An atom, a group of persons, a fluid."@en ;
    skos:prefLabel "Fusion"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: CausalCluster or CausalStructure"^^xsd:string ;
    ns1:conceptualisation "A mereological fusion is any entity that is made up of two or more quantum entities, regardless of the fact that they are or not self-connected. It captures the idea of set, but excluding singletons."@en ;
    ns1:definition "The union of the CausalCluster and CausalStructure classes."@en ;
    ns1:elucidation "The class of individuals representing mereological fusions consisting of two or more quantum entities."@en .

ns1:EMMO_555d0261_da5e_4301_b7f9_46f604a32e91 a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "directlyCauses"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:subPropertyOf ns1:EMMO_d67ee67e_4fac_4676_82c9_aec361dba698 ;
    owl:propertyDisjointWith ns1:EMMO_b85e4738_500c_4e1b_bbe8_9e84190485d6 ;
    skos:altLabel "isDirectCauseOf"@en ;
    skos:prefLabel "directlyCauses"@en ;
    ns1:conceptualisation """Direct causality is a concept that captures the idea of direct interaction between two entities, given the fact that there are no causal intermediaries between them. It requires that at least a quantum of the causing entity is direct cause of a quantum of the caused entity.
It does not exclude the possibility of other indirect causal routes between some proper parts of the two entities.
The direct causality in a 4D ontology covers both time-like causal interaction (when causality is one-way from one entity to another) and space-like causal interaction (when causality is two-way between two entities)."""@en ;
    ns1:elucidation "A causal relation between the causing and the effected entities occurring without intermediaries."@en ;
    ns1:note "Direct cause is irreflexive."@en,
        "Direct cause provides the edges for the transitive restriction of the direct acyclic causal graph whose nodes are the quantum entities."@en .

ns1:EMMO_707f0cd1_941c_4b57_9f20_d0ba30cd6ff3 a owl:Class ;
    rdfs:label "ArithmeticOperator"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf ns1:EMMO_3c424d37_cf62_41b1_ac9d_a316f8d113d6 ;
    skos:prefLabel "ArithmeticOperator"@en .

ns1:EMMO_74a75cf1_3418_4244_b43c_b5db94635d42 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "hasTile"@en ;
    rdfs:domain ns1:EMMO_ee0466e4_780d_4236_8281_ace7ad3fc5d2 ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:range ns1:EMMO_9953c19f_ee33_4af8_be5e_dbf6d1e33581 ;
    rdfs:subPropertyOf ns1:EMMO_814b6b76_e0ca_4953_a832_d1816fb695f1 ;
    skos:altLabel "hasDirectPart"@en ;
    skos:prefLabel "hasTile"@en ;
    ns1:conceptualisation """Tiling parthood enables the establishment of hierarchy of granularities, starting with an entity and providing several tessellation levels according to specific criteria.
The criteria are implemented in specialised versions of the tiling parthood relation (e.g., metrological direct part, XML format direct part).
The tiles and the tessellated entity (tessellation) are causally self connected (i.e., items), coherently with the concept behind the definition of the reductionistic perspective.
The tiles of specific granularity level provide a covering for the whole and are mutually non-overlapping, as the label "tile" suggests."""@en ;
    ns1:elucidation "The relation grouping all direct parthood relations used in the reductionistic perspective."@en ;
    ns1:note "This relation is a simple collector of all relations inverse functional direct parthoods that can be defined in specialised theories using reductionism."^^xsd:string,
        "This relation is not antitransitive, to enable partitioning of a causal structure with more than one tiling scheme (e.g. time and space partitioning)."@en .

ns1:EMMO_76bd5e44_bf5a_49f9_a517_eea5e8bcbc2d a owl:Class ;
    rdfs:label "CausalCluster"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:subClassOf ns1:EMMO_53ed8611_2cd7_4286_9ef0_36572117b963 ;
    skos:prefLabel "CausalCluster"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: Collection or CausalSystem"^^xsd:string ;
    ns1:conceptualisation "With the causal cluster term we address an heterogeneous group of entities, which possess the common feature of having at least two causally non connected quanta. It comprises collections (non self-connected entities) and causal systems (entities extended in space)."@en ;
    ns1:definition "The disjoint union of the CausalSystem and Collection classes."@en ;
    ns1:elucidation "The class of individuals representing causal clusters."@en .

ns1:EMMO_846b637b_7b12_47a1_9430_0274b2f588ac a owl:Class ;
    rdfs:label "ProcessByContext"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:subClassOf ns1:EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce ;
    skos:prefLabel "ProcessByContext"@en ;
    ns1:elucidation "The superclass for all classes that categorise projects according to their mereological and persistence context"@en .

ns1:EMMO_8bb6b688_812a_4cb9_b76c_d5a058928719 a owl:Class ;
    rdfs:label "Semiotics"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:seeAlso "https://plato.stanford.edu/entries/peirce-semiotics/"^^xsd:anyURI,
        "https://github.com/emmo-repo/EMMO/wiki/EMMO-Introduction#25-Semiotic-Framework"^^xsd:string ;
    rdfs:subClassOf ns1:EMMO_49267eba_5548_4163_8f36_518d65b583f9 ;
    skos:prefLabel "Semiotics"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: Semiosis or SemioticEntity"^^xsd:string ;
    ns1:elucidation "A perspective based on Pierce semiotics, where an interpreter relates a referent to a sign in through semiotic relations."@en .

ns1:EMMO_9cb984ca_48ad_4864_b09e_50d3fff19420 a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "overcrosses"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:subPropertyOf ns1:EMMO_d893d373_b579_4867_841e_1c2b31a8d2c6 ;
    owl:inverseOf ns1:EMMO_e4f66254_7312_4de5_a86a_6e0808baaaab ;
    owl:propertyDisjointWith ns1:EMMO_a8bd7094_6b40_47af_b1f4_a69d81a3afbd ;
    skos:prefLabel "overcrosses"@en ;
    ns1:definition "OX(x, y) ≡ O(x, y) ∧ ¬P(x,y)"^^xsd:string ;
    ns1:elucidation "The relation between an entity that overlaps another without being its part."@en .

ns1:EMMO_9d799b43_e188_4047_8167_121d96b31a26 a owl:Class ;
    rdfs:label "ObjectByContext"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:subClassOf ns1:EMMO_90ae56e4_d197_49b6_be1a_0049e4756606 ;
    skos:prefLabel "ObjectByContext"@en ;
    ns1:elucidation "The superclass for all classes that categorise objects according to their mereological and persistence context"@en .

ns1:EMMO_b2282816_b7a3_44c6_b2cb_3feff1ceb7fe a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "hasSpatialTile"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:range ns1:EMMO_4cf484af_082a_40f5_9f11_930bf4634482 ;
    rdfs:subPropertyOf ns1:EMMO_7efab93d_c8fe_49c7_ba8e_d21d13b38c85 ;
    skos:altLabel "hasSpatialDirectPart"@en ;
    skos:prefLabel "hasSpatialTile"@en ;
    ns1:elucidation "A relation between the whole and one of its tiles, where the tile is only spatially connected with the other tiles forming the tessellation."^^xsd:string .

ns1:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba a owl:Class ;
    rdfs:label "Property"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf ns1:EMMO_38f31ba5_348f_4ac2_9a67_a62b5dd7aadd ;
    skos:example """Hardness is a subclass of properties.
Vickers hardness is a subclass of hardness that involves the procedures and instruments defined by the standard hardness test."""@en,
        "The name \"red\" which is atomic in the code made of the list of colors."@en ;
    skos:prefLabel "Property"@en ;
    ns1:elucidation "A coded that makes use of an atomic symbol with respect to the code used to refer to the interaction."@en ;
    ns1:note "A property is atomic in the sense that is aimed to deliver one and one only aspect of the object according to one code, such as the color with one sign (e.g., black) or a quantitiative property (e.g., 1.4 kg)."@en .

ns1:EMMO_b803f122_4acb_4064_9d71_c1e5fd091fc9 a owl:Class ;
    rdfs:label "SemioticEntity"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf ns1:EMMO_8bb6b688_812a_4cb9_b76c_d5a058928719 ;
    skos:prefLabel "SemioticEntity"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: Interpreter or SemioticObject or Sign"^^xsd:string ;
    ns1:elucidation "The class of individuals that stands for semiotic objects, i.e. objects that take part on a semiotic process."@en ;
    ns1:note """Semiotic subclasse are defined using Peirce's semiotic theory.

"Namely, a sign is something, A, which brings something, B, its interpretant sign determined or created by it, into the same sort of correspondence with something, C, its object, as that in which itself stands to C." (Peirce 1902, NEM 4, 20–21).

The triadic elements:
- 'sign': the sign A (e.g. a name)
- 'interpretant': the sign B as the effects of the sign A on the interpreter (e.g. the mental concept of what a name means)
- 'object': the object C (e.g. the entity to which the sign A and B refer to)

This class includes also the 'interpeter' i.e. the entity that connects the 'sign' to the 'object'"""@en .

ns1:EMMO_ceaaf9f7_fd11_424b_8fda_9afa186af186 a owl:Class ;
    rdfs:label "Constituent"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:EMMO_dba27ca1_33c9_4443_a912_1519ce4c39ec ] ;
            owl:someValuesFrom ns1:EMMO_90ae56e4_d197_49b6_be1a_0049e4756606 ],
        ns1:EMMO_9d799b43_e188_4047_8167_121d96b31a26 ;
    skos:altLabel "ObjectPart"@en ;
    skos:example "A tire is a constituent of a car."@en ;
    skos:prefLabel "Constituent"@en ;
    ns1:elucidation "An object which is a spatial part of another object."@en .

ns1:EMMO_d01b3ee2_91a5_4ce2_95cd_f0d2c333c6d3 a owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "alongsideWith"@en ;
    rdfs:domain ns1:EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:range ns1:EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d ;
    rdfs:subPropertyOf ns1:EMMO_54d0d0f4_d9fa_4179_a9b5_4110c49dafff,
        ns1:EMMO_5dc167a2_d50e_47a5_be4f_5139f3bff2ec,
        ns1:EMMO_b85e4738_500c_4e1b_bbe8_9e84190485d6 ;
    skos:altLabel "coexistsWith"@en,
        "concurrentWith"@en,
        "interactsWith"@en ;
    skos:example "I'm interacting with another tennis player through a ball. Or, two people in a webconference are interacting using a mediator which is the network signal."@en ;
    skos:prefLabel "alongsideWith"@en ;
    ns1:elucidation "The relation between two causally reachable entities through a path of contacts relations (i.e. representing physical interactions)."@en .

ns1:EMMO_da27d905_beb6_44ea_a330_a2dd9c17b263 a owl:ObjectProperty ;
    rdfs:label "hasInternalRepresentation"@en ;
    rdfs:domain ns1:EMMO_0527413c_b286_4e9c_b2d0_03fb2a038dee ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:range ns1:EMMO_054af807_85cd_4a13_8eba_119dfdaaf38b ;
    rdfs:subPropertyOf ns1:EMMO_f275e4e9_062b_4ca4_a679_4f26ec0a48ae ;
    skos:prefLabel "hasInternalRepresentation"@en ;
    ns1:elucidation "The relation between the interpreter and the interpretant, being its internal representation."@en .

ns1:EMMO_eb3518bf_f799_4f9e_8c3e_ce59af11453b a owl:ObjectProperty ;
    rdfs:label "hasConvention"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:range ns1:EMMO_35d2e130_6e01_41ed_94f7_00b333d46cf9 ;
    rdfs:subPropertyOf ns1:EMMO_60577dea_9019_4537_ac41_80b0fb563d41 ;
    skos:prefLabel "hasConvention"@en ;
    ns1:elucidation "A semiotic relation that connects a declared semiotic object to a conventional sign in a declaration process."@en .

ns1:EMMO_ebc9e62c_5dc4_44db_9060_7923740bdf78 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "isBefore"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:subPropertyOf ns1:EMMO_d67ee67e_4fac_4676_82c9_aec361dba698 ;
    skos:altLabel "isTemporallyBefore"@en ;
    skos:prefLabel "isBefore"@en ;
    ns1:definition "A relation jointly covered by hasNext and hasSuccessor relations, which are mutually exclusive."@en ;
    ns1:elucidation "A relation between entities that are only one-directionally causally connected."@en .

ns1:EMMO_ee0466e4_780d_4236_8281_ace7ad3fc5d2 a owl:Class ;
    rdfs:label "Tessellation"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/reductionistic#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:EMMO_74a75cf1_3418_4244_b43c_b5db94635d42 ;
            owl:someValuesFrom ns1:EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de ],
        ns1:EMMO_15db234d_ecaf_4715_9838_4b4ec424fb13 ;
    skos:altLabel "Tiling"@en ;
    skos:prefLabel "Tessellation"@en ;
    ns1:conceptualisation "A tessellation (or tiling) is the covering of a surface, often a plane, using one or more geometric shapes, called tiles, with no overlaps and no gaps."@en ;
    ns1:elucidation "A causal structure that is tessellated in direct parts."@en .

:Dimension a owl:Class ;
    rdfs:label "Dimension"@en ;
    rdfs:comment "A dimension of an Entity. Dimensions have a label, which i unique within the scope of the Entity and a human description."@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty :hasDescription ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty :hasLabel ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ns1:EMMO_ceaaf9f7_fd11_424b_8fda_9afa186af186,
        :DataModel ;
    skos:prefLabel "Dimension"@en .

:hasDescription a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "hasDescription"@en ;
    rdfs:comment "An human readable description of a class."@en ;
    rdfs:domain :DataModel ;
    rdfs:isDefinedBy <https://w3id.org/emmo/domain/datamodel/entity#> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf :dataComposition ;
    skos:prefLabel "hasDescription"@en .

ns1:EMMO_1328d112_e731_4e56_b9b9_6b6cdd495cd6 a owl:ObjectProperty ;
    rdfs:label "hasDistinctPart"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:subPropertyOf ns1:EMMO_9380ab64_0363_4804_b13f_3a8a94119a76 ;
    owl:inverseOf ns1:EMMO_9f55743f_a5e2_4a75_a68c_978c36117dec ;
    skos:example "A molecule is a distinct part of a fluid."@en ;
    skos:prefLabel "hasDistinctPart"@en ;
    ns1:definition "DP(x, y) ≡ PP(x, y) ∧ ∃φ[φ(x) ↔ ¬φ(y)]"^^xsd:string ;
    ns1:elucidation "The superproperty of all object property relations between an entity and one of its proper parts that belongs to different taxonomical branch."@en ;
    ns1:note "A part is always distinct xor redundant."@en .

ns1:EMMO_1eed0732_e3f1_4b2c_a9c4_b4e75eeb5895 a owl:Class ;
    rdfs:label "Variable"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf ns1:EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0 ;
    skos:example """x
k"""@en ;
    skos:prefLabel "Variable"@en ;
    ns1:elucidation "A variable is a symbolic object that stands for any other mathematical object, such as  number, a vector, a matrix, a function, the argument of a function, a set, an element of a set."@en .

ns1:EMMO_2d72e38c_d587_437f_98f6_f2718fb130eb a owl:Class ;
    rdfs:label "Declarer"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:EMMO_cb804456_9459_4be5_ac63_a291a872fbd0 ] ;
            owl:someValuesFrom ns1:EMMO_47bf3513_4ae6_4858_9c45_76e23230d68d ],
        ns1:EMMO_33dc57d7_68bd_460c_a440_26a78d57ea0d ;
    skos:example "A scientist that assigns a quantity to a physical objects without actually measuring it but taking it for granted due to its previous experience (e.g. considering an electron charge as 1.6027663e-19 C, assigning a molecular mass to a gas only by the fact of a name on the bottle)."^^xsd:string,
        "Someone who assigns a name to an object."^^xsd:string ;
    skos:prefLabel "Declarer"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: Determiner or Namer"^^xsd:string ;
    ns1:elucidation "An interpreter who establish the connection between an conventional sign and an object according to a specific convention."@en .

ns1:EMMO_35d2e130_6e01_41ed_94f7_00b333d46cf9 a owl:Class ;
    rdfs:label "Conventional"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf ns1:EMMO_9e3ad976_b179_4315_b51e_7e874df583dc ] ;
            owl:someValuesFrom ns1:EMMO_47bf3513_4ae6_4858_9c45_76e23230d68d ],
        ns1:EMMO_4a2bf359_c47b_4aa3_9811_b59c3e1dac1e ;
    skos:prefLabel "Conventional"@en ;
    ns1:OWLRL2DLAxioms "EquivalentTo: Uncoded or Coded"^^xsd:string ;
    ns1:elucidation "A 'Sign' that stands for an 'Object' through convention, norm or habit, without any resemblance to it."@en ;
    ns1:note "In Peirce semiotics this kind of sign category is called symbol. However, since symbol is also used in formal languages, the name is changed in conventional."@en .

ns1:EMMO_36e69413_8c59_4799_946c_10b05d266e22 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "hasInput"@en ;
    rdfs:domain ns1:EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:subPropertyOf ns1:EMMO_1cfd072d_2157_43e2_b9f6_ff1e7a708774 ;
    skos:prefLabel "hasInput"@en ;
    ns1:elucidation "The relation between a process P that proper overlaps an item I, where the non-overlapping part of I causes P."@en ;
    ns1:illustration "https://raw.githubusercontent.com/emmo-repo/EMMO/dev/doc/figs/hasInput.png"^^xsd:string .

ns1:EMMO_55354438_7000_4284_b1b9_59d60c2261b9 a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "hasPortionPart"@en ;
    rdfs:domain ns1:EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:subPropertyOf ns1:76413949_896c_4363_a955_de4722c6e149 ;
    skos:prefLabel "hasPortionPart"@en ;
    ns1:definition "A proper part relation with domain restricted to items."@en ;
    ns1:note "A part of an item is always non-maximal, meaning that is causally connected with the rest."@en .

ns1:EMMO_5be83f9c_a4ba_4b9a_be1a_5bfc6e891231 a owl:Class ;
    rdfs:label "MathematicalSymbol"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty ns1:EMMO_9380ab64_0363_4804_b13f_3a8a94119a76 ;
                    owl:someValuesFrom ns1:EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0 ] ],
        ns1:EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0,
        ns1:EMMO_a1083d0a_c1fb_471f_8e20_a98f881ad527 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:EMMO_54ee6b5e_5261_44a8_86eb_5717e7fdb9d0 ns1:EMMO_a1083d0a_c1fb_471f_8e20_a98f881ad527 ) ] ;
    skos:prefLabel "MathematicalSymbol"@en .

ns1:EMMO_65a007dc_2550_46b0_b394_3346c67fbb69 a owl:Class ;
    rdfs:label "HolisticSystem"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/reference/persholistic#> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:EMMO_3c7f239f_e833_4a2b_98a1_c88831770c1b ;
            owl:someValuesFrom ns1:EMMO_f76884f7_964e_488e_9bb7_1b2453e9e817 ],
        ns1:EMMO_1efe8b96_e006_4a33_bc9a_421406cbb9f0,
        ns1:EMMO_90ae56e4_d197_49b6_be1a_0049e4756606,
        ns1:EMMO_e7aac247_31d6_4b2e_9fd2_e842b1b7ccac ;
    skos:prefLabel "HolisticSystem"@en ;
    ns1:OWLRL2DLAxioms "SubClassOf: hasComponent some Component"^^xsd:string ;
    ns1:elucidation "An object that is made of a set of sub objects working together as parts of a mechanism or an interconnecting network (natural or artificial); a complex whole."@en ;
    ns1:note "A system is conceived as an aggregate of things that 'work' (or interact) together. While a system extends in time through distinct temporal parts (like every other 4D object), this elucdation focuses on a timescale in which the obejct shows a persistence in time."@en .

ns1:EMMO_6735d3ff_67f8_43b5_b5b0_240fbfab4517 a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "isCausedBy"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:seeAlso ns1:EMMO_d67ee67e_4fac_4676_82c9_aec361dba698 ;
    rdfs:subPropertyOf ns1:EMMO_ad0e72fc_dcaa_490d_8371_b4d814dcda2c ;
    owl:inverseOf ns1:EMMO_d67ee67e_4fac_4676_82c9_aec361dba698 ;
    skos:altLabel "causes"@en ;
    skos:prefLabel "isCausedBy"@en .

ns1:EMMO_82a96de2_41aa_4bf7_b7ac_de1373d50160 a owl:ObjectProperty ;
    rdfs:label "standsFor"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subPropertyOf ns1:EMMO_2337e25c_3c60_43fc_a8f9_b11a3f974291 ;
    skos:prefLabel "standsFor"@en .

ns1:EMMO_a8bd7094_6b40_47af_b1f4_a69d81a3afbd a owl:ObjectProperty ;
    rdfs:label "isPartOf"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:seeAlso ns1:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f ;
    rdfs:subPropertyOf ns1:EMMO_d893d373_b579_4867_841e_1c2b31a8d2c6 ;
    skos:prefLabel "isPartOf"@en ;
    ns1:definition """Reflexivity: Pxx
Transitivity: (Pxy ∧ Pyz) → Pxz
Antisymmetry: (Pxy ∧ Pyx) → x=y."""@en ;
    ns1:elucidation "The inverse relation of hasPart."@en .

ns1:EMMO_ad0e72fc_dcaa_490d_8371_b4d814dcda2c a owl:ObjectProperty ;
    rdfs:label "causal"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/foundation/mereocausality#> ;
    rdfs:subPropertyOf ns1:EMMO_ec2472ae_cf4a_46a5_8555_1556f5a6c3c5 ;
    skos:prefLabel "causal"@en ;
    ns1:conceptualisation """Causality is the fundamental concept describing how entities affect each other, and conceptually precedes time and space relations. In the EMMO causality is the foundation for space and time relations.
Embracing a strong reductionistic view, causality originates at quantum entities level, meaning that causal relations between macroscopic entities is simply the sum of quantum level causality relations."""@en ;
    ns1:elucidation "The superclass of all causal EMMO relations."@en ;
    ns1:note "Causality in the EMMO is intended as physical causation and not counter-factual. Meaning that causality is an expression of actual physical interactions, and not of a counterfactual depence such as “I didn't water the flowers, hence, I'm the cause of their death”."@en,
        "Each pair of entities is either in isCauseOf or isNotCauseOf relation. The two are mutually exclusive."@en .

ns1:EMMO_cd9a3a58_dabc_4c46_9ea4_03ca000b2022 a owl:ObjectProperty ;
    rdfs:label "interprets"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:subPropertyOf ns1:EMMO_2337e25c_3c60_43fc_a8f9_b11a3f974291 ;
    skos:prefLabel "interprets"@en .

