ns1:EMMO_1141d225_fe90_4230_82c6_31cab6a4e3fe a owl:Class ;
    rdfs:label "SymbolicByStructure"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/math#> ;
