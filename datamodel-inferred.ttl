ns1:EMMO_3c51ea74_43a4_42d5_953b_fcb43f359c73 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "influences"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
    rdfs:subPropertyOf ns1:EMMO_7d77a013_1a0c_46fe_a6d8_ef6f4abb44fa ;
    skos:prefLabel "influences"@en ;
    ns1:elucidation "The relation between a process P that proper overlaps an object O, where the non overlapping part of P is cause of O."@en .

ns1:EMMO_3c87fd89_b0f0_477a_86b6_d949c2b982ee a owl:Class ;
    rdfs:label "ByteData"@en ;
    rdfs:isDefinedBy <https://w3id.org/emmo/reference/symbolic#> ;
    rdfs:seeAlso "https://www.w3.org/TR/xmlschema11-2/#byte"^^xsd:anyURI ;
