    rdfs:range ns1:EMMO_210e7e99_c1cf_44cc_87c7_310a10ff068b ;
    rdfs:subPropertyOf ns1:EMMO_7afbed84_7593_4a23_bd88_9d9c6b04e8f6 ;
    skos:prefLabel "hasBehaviour"@en .

ns1:EMMO_edf72228_e040_4edc_8b46_78b2a47c72d7 a owl:Class ;
