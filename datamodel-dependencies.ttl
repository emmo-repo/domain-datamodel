    owl:propertyDisjointWith emmo:EMMO_9380ab64_0363_4804_b13f_3a8a94119a76 ;
    skos:prefLabel "equalsTo"@en ;
    emmo:elucidation "The relation between two individuals representing the same entity."@en ;
    emmo:note "Equality is here defined following a mereological approach."@en .

