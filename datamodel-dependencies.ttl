emmo:EMMO_64e4d7b0_f07b_4328_9282_7bf9fb0c3d09 a owl:ObjectProperty ;
    rdfs:label "hasPropertyPart"@en ;
    rdfs:domain emmo:EMMO_35d4c439_fcb6_4399_a855_a89a207b41e9 ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
    rdfs:range emmo:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba ;
    rdfs:subPropertyOf emmo:EMMO_55354438_7000_4284_b1b9_59d60c2261b9 ;
    emmo:elucidation "The relation connecting a description with its property parts. Description and parts are signs for the same entity"@en ;
    emmo:note "This relation is used to specify the detailed information that make up the overall description for an entity. A description can be used to summarize in one single entiity several properties relaterd to the same referent."@en .

emmo:EMMO_663859e5_add3_4c9e_96fb_c99399de278d a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
