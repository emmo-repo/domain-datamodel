emmo:EMMO_c5b4c32b_74de_403d_96f2_266bec8bd0e8 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain emmo:EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de ;
