emmo:EMMO_0914449c_ef24_4372_b669_9cdd13b59fed a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/structural#> ;
    rdfs:subClassOf emmo:EMMO_57c75ca1_bf8a_42bc_85d9_58cfe38c7df2 ;
    skos:prefLabel "Minimal"@en ;
    emmo:elucidation "The superclass for all classes of entities that have no proper parts of the same type of the whole is proper part of an entity of that type."@en ;
    emmo:illustration "https://raw.githubusercontent.com/emmo-repo/EMMO/1.0.2/doc/figs/Minimal.png"^^xsd:anyURI ;
    emmo:note "A minimal class M (subclass of Minimal) is defined by choosing a reference type φ so that M is subclass of φ, all parts of x are needed to keep φ(x) and x is proper part of a larger φ entity."@en .

