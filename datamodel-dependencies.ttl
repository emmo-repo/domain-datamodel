[] a owl:Axiom ;
    owl:annotatedProperty emmo:definition ;
    owl:annotatedSource emmo:EMMO_1328d112_e731_4e56_b9b9_6b6cdd495cd6 ;
    owl:annotatedTarget "DP(x, y) ≡ PP(x, y) ∧ ∃φ[φ(x) ↔ ¬φ(y)]"^^xsd:string ;
    emmo:note "We usa a predicate template notation as DP<φ>(x,y) to specify subclasses of DP(x,y) for the class φ, meaning that DP<φ>(x, y) ≡ PP(x, y) ∧ (φ(x) ↔ ¬φ(y))"@en,
        "φ is a class of the theory"@en .

